<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tv_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● AI PULSE"
            android:textColor="#FF6B1A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Sincronizando..."
            android:textColor="#FAF4ED"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_quotas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:text="CL --/--% · AGY --/--%"
            android:textColor="#E09F3E"
            android:textSize="9.5sp"
            android:singleLine="true"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_refresh"
            android:layout_width="28dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:background="@drawable/row_bg"
            android:text="↻"
            android:textColor="#FAF4ED"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 1 -->
    <LinearLayout
        android:id="@+id/row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/row_bg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/r1_prov"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AGY"
            android:textColor="#FACC15"
            android:textSize="9sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/r1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Proyecto"
            android:textColor="#FAF4ED"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/r1_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="● Lista"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/r1_approve"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/row_bg"
            android:text="✓ Aprobar"
            android:textColor="#10B981"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:id="@+id/row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/row_bg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/r2_prov"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AGY"
            android:textColor="#FACC15"
            android:textSize="9sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/r2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Proyecto"
            android:textColor="#FAF4ED"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/r2_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="● Lista"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/r2_approve"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/row_bg"
            android:text="✓ Aprobar"
            android:textColor="#10B981"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout
        android:id="@+id/row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/row_bg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/r3_prov"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AGY"
            android:textColor="#FACC15"
            android:textSize="9sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/r3_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Proyecto"
            android:textColor="#FAF4ED"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/r3_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="● Lista"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/r3_approve"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/row_bg"
            android:text="✓ Aprobar"
            android:textColor="#10B981"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Footer / Empty state -->
    <TextView
        android:id="@+id/tv_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tocá una consola para abrir el chat y responder"
        android:textColor="#9A8878"
        android:textSize="9sp"
        android:singleLine="true"
        android:ellipsize="end" />

</LinearLayout>
